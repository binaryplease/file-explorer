{
  "name": "binp-file-explorer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "bin": {
    "bfe": "./dist/server/cli.js"
  },
  "exports": {
    "./mount": "./src/mount.tsx",
    "./theme.css": "./src/theme.css"
  },
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "dev:ports": "bun scripts/dev-ports.ts",
    "dev:server": "bun --watch server/index.ts",
    "dev:client": "bunx vite",
    "cli": "bun server/cli.ts",
    "build": "bunx vite build && NODE_ENV=production bun build server/index.ts server/cli.ts --outdir dist/server --target bun --sourcemap=linked --production",
    "start": "NODE_ENV=production bun dist/server/index.js",
    "typecheck": "bunx tsc --noEmit"
  },
  "dependencies": {
    "@elysiajs/openapi": "^1.4.15",
    "@fontsource-variable/inter": "^5.3.0",
    "@tabler/icons-react": "^3.44.0",
    "elysia": "^1.4.28",
    "mermaid": "^11.16.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^3",
    "tailwindcss": "^4.2.0",
    "yaml": "^2.9.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@types/bun": "^1.3.9",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.0",
    "typescript": "^5.7",
    "vite": "^8.0.9"
  }
}
